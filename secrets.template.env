# ============================================================================
#  FBStore Academy : FEUILLE DE CLÉS (à remplir sur votre ordinateur, ne jamais publier)
#  Lisez GUIDE-API.md. Vous pouvez aussi utiliser outils/assistant-api.html (même chose, avec vérification).
# ============================================================================

# ---- A. SECRETS SUPABASE (Edge Functions > Secrets) : TOUS OPTIONNELS --------------------------------
# Les clés de paiement se saisissent maintenant dans l'Admin (Config. paiements). Laissez vide sauf secours.
SASPAY_API_KEY=            # secours seulement : sk_test_... ou sk_live_... (app.saspay.me > Développeur)
SASPAY_BASE_URL=           # optionnel : https://api.saspay.me/api/v1
FB_GRAPH_VERSION=          # optionnel : v23.0

# ---- B. À SAISIR DANS L'ADMIN (stockées dans la base, visibles du super admin seulement) ---------------
# Admin > Config. paiements
#   Clé secrète de test ........ sk_test_...        (facultative)
#   Clé secrète de production .. sk_live_...        (facultative)
#   Secret d'accès du webhook .. (bouton "Générer un secret")
#   Signature du webhook ....... secret de signature affiché par SasPay quand vous créez le webhook
# Admin > Paramètres
#   Pixel ID Meta .............. chiffres, ex. 123456789012345
#   Token Conversions API ...... EAAB... (Meta Events Manager > Paramètres > Conversions API)
#   Code de test Meta .......... TEST12345 (Events Manager > Tester les événements)
#   Mesure Google Analytics .... G-XXXXXXXXXX
#   Clé secrète Measurement Protocol GA4 ... (Admin GA4 > Flux de données > Secrets API)
# Admin > Notifications
#   Clés VAPID ................. bouton "Générer les clés" (une seule fois)

# ---- C. CONFIG PUBLIQUE (config.js, visible par les visiteurs : jamais de secret ici) -----------------
# URL ........ https://VOTRE-PROJET.supabase.co
# KEY ........ clé Publishable (Supabase > Project Settings > API)

# ---- D. FOURNIS AUTOMATIQUEMENT PAR SUPABASE (ne rien faire) ------------------------------------------
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
